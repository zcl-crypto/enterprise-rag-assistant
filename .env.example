# Copy to .env for Docker Compose and replace all change-me values before startup.
POSTGRES_PASSWORD=change-me-database-password
DEMO_PASSWORD=change-me-demo-password
JWT_SECRET=change-me-to-a-random-string-at-least-32-characters
LLM_API_KEY=
LLM_ENABLED=1
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
LLM_MODEL=glm-4.7-flash
LLM_DAILY_TOKEN_LIMIT=200000
EMBEDDING_MODEL_PATH=.models/bge-small-zh-v1.5
RETRIEVAL_MODE=hybrid
FASTEMBED_CACHE_PATH=.models/fastembed
ENABLE_RERANKER=0
RERANKER_MODEL_PATH=.models/bge-reranker-base
